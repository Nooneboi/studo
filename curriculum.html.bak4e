        <a href="resources.html">Resources</a>
      </nav>
      <div id="theme-switch-mount"></div>
    </div>
  </div>
</header>
<div id="subject-bar-mount"></div>

<main class="curriculum-main">
  <div class="wrap curriculum-wrap" id="curriculum-view"></div>
</main>

<footer class="site-footer">
  <div class="wrap">Studo — built for practice, not for tracking you.</div>
</footer>

<script src="js/app.js"></script>
<script src="js/theme.js"></script>
<script src="js/subjectbar.js"></script>
