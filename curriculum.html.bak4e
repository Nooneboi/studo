<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/studo-v2.css">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a href="index.html" class="brand"><span class="brand-mark">&#9670;</span> Studo</a>
    <div class="header-right">
      <nav class="site-nav">
        <a href="index.html">Home</a>
        <a href="practice.html">Practice</a>
        <a href="train.html">Train</a>
        <a href="quiz.html">Quiz</a>
